# AI Smart Bazar — Backend Environment Variables

APP_NAME="AI Smart Bazar"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL 16 with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://siddeshwar_user:siddeshwar_secure_pass_2026@localhost:5432/siddeshwar_erp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Security & Authentication
SECRET_KEY=change_this_to_a_very_long_cryptographically_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute

# Structured Logging
LOG_LEVEL=INFO

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
